{
  "name": "gulbahar-business-card-generator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3107",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:exports": "node --import tsx scripts/verify-exports.ts",
    "verify:visual": "python3 scripts/compare-reference.py",
    "check:assets": "node scripts/check-assets.mjs",
    "install:assets": "node scripts/install-assets.mjs",
    "prebuild": "npm run prepare:assets",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "package:fonts": "node scripts/package-fonts.mjs",
    "test:api": "node --import tsx scripts/smoke-api.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "fontkit": "^2.0.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "jszip": "^3.10.1",
    "zod": "^4.1.0",
    "lucide-react": "^0.468.0",
    "@supabase/supabase-js": "^2.119.2",
    "@supabase/ssr": "^0.12.7"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/fontkit": "^2.0.8",
    "@types/qrcode": "^1.5.5",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "jsqr": "^1.4.0"
  },
  "type": "module",
  "overrides": {
    "picomatch": "4.0.7"
  },
  "engines": {
    "node": "24.x"
  }
}
