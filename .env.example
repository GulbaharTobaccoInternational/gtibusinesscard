# Local generation works with separately installed official fonts.
# Vercel/Git builds restore the encrypted fonts using this build-only secret.
# Set it in Vercel as a Secret; never use a NEXT_PUBLIC_ prefix or commit its value.
GULBAHAR_FONT_KEY=
# Supabase public project configuration (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
# Server-only runtime credentials. Never add NEXT_PUBLIC_ to these names.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# Management tokens and database passwords are operator-only; never deploy them.
